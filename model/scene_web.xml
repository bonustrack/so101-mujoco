<!-- Scene for the web demo. Derived from the Menagerie scene_box.xml: same arm,
     floor and box material. The box is a 3 x 3 x 4 cm cube placed where a
     top-down grasp reaches it: the SO-101 jaws hold it square and it weighs 36 g.
     The site draws the scene with three.js, so the Menagerie visual settings are left out. -->
<mujoco model="so101 web">
  <include file="so101.xml"/>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane"/>
    <body name="box" pos="0.2 0.08 0.02">
      <freejoint/>
      <geom type="box" name="box" size="0.015 0.015 0.02" condim="3" friction="1 .03 .003" rgba="0.09 0.32 0.94 1"
        contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
  </worldbody>
</mujoco>
