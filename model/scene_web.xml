<!-- Scene for the web demo. Derived from the Menagerie scene_box.xml: same arm,
     floor and box, with the box moved within reach of the gripper. The site
     draws the scene with three.js, so the Menagerie visual settings are left out. -->
<mujoco model="so101 web">
  <include file="so101.xml"/>

  <worldbody>
    <geom name="floor" size="0 0 0.05" type="plane"/>
    <body name="box" pos="0.28 0.1 0.03">
      <freejoint/>
      <geom type="box" name="box" size="0.02 0.02 0.03" condim="3" friction="1 .03 .003" rgba="0.09 0.32 0.94 1"
        contype="2" conaffinity="1" solref="0.01 1"/>
    </body>
  </worldbody>
</mujoco>
